{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": ["/^_Avoid_:.*$/m"]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "である",
        "preferInList": "である",
        "strict": false
      },
      "no-doubled-joshi": {
        "min_interval": 1,
        "allow": ["も", "や", "か", "でも"]
      }
    },
    "prh": { "rulePaths": ["prh.yml"] }
  }
}
