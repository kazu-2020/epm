{
  "realm": "customer",
  "enabled": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "fixed-rsa",
        "providerId": "rsa",
        "config": {
          "priority": [
            "1000"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ],
          "algorithm": [
            "RS256"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "http://localhost:8080/realms/epm",
      "protocol": "saml",
      "enabled": true,
      "redirectUris": [
        "http://localhost:8080/realms/epm/broker/acme/endpoint"
      ],
      "attributes": {
        "saml_name_id_format": "email",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:8080/realms/epm/broker/acme/endpoint"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "firstName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "firstName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "lastName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "lastName",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Acme",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}
