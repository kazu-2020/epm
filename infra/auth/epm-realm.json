{
  "realm": "epm",
  "enabled": true,
  "organizationsEnabled": true,
  "clients": [
    {
      "clientId": "app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "organization"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "acme",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "singleSignOnServiceUrl": "http://localhost:8080/realms/customer/protocol/saml",
        "entityId": "http://localhost:8080/realms/epm",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "validateSignature": "true",
        "signingCertificate": "",
        "wantAssertionsSigned": "true",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "acme",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "acme",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "acme",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    }
  ],
  "organizations": [
    {
      "name": "acme",
      "alias": "acme",
      "enabled": true,
      "domains": [
        {
          "name": "acme.test",
          "verified": true,
          "identityProviderAlias": "acme",
          "autoRedirect": true
        }
      ],
      "identityProviders": [
        {
          "alias": "acme"
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bob",
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Password",
      "enabled": true,
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    }
  ]
}
